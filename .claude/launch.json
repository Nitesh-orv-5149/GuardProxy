{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "guardproxy",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "src.main:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "guardproxy-live-ollama",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "src.main:app", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001,
      "env": { "DRY_RUN": "false", "API_ENDPOINT": "http://localhost:11434" }
    }
  ]
}
